{
  "name": "arguebuf",
  "version": "3.0.0",
  "repository": "github:recap-utr/arguebuf-typescript",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./dist/*",
    "#data/*": "./data/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./argdown": {
      "types": "./dist/argdown.d.ts",
      "default": "./dist/argdown.js"
    },
    "./graphology": {
      "types": "./dist/graphology.d.ts",
      "default": "./dist/graphology.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --dir tests",
    "tsc": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2",
    "ajv": "^8",
    "approx-string-match": "^2",
    "arg-services": "^4",
    "parse5": "^8",
    "ts-graphviz": "^3",
    "word-wrap": "^1"
  },
  "devDependencies": {
    "@argdown/core": "^2",
    "graphology": "^0.26",
    "temporal-polyfill": "^1",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^5",
    "zod": "^4"
  },
  "peerDependencies": {
    "@argdown/core": "^2",
    "graphology": "^0.26"
  },
  "peerDependenciesMeta": {
    "@argdown/core": {
      "optional": true
    },
    "graphology": {
      "optional": true
    }
  }
}
