{
  "name": "arguebuf",
  "version": "2.0.2",
  "repository": "github:recap-utr/arguebuf-typescript",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./dist/*",
    "#data/*": "./data/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./argdown": {
      "types": "./dist/argdown.d.ts",
      "default": "./dist/argdown.js"
    },
    "./graphology": {
      "types": "./dist/graphology.d.ts",
      "default": "./dist/graphology.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --dir tests",
    "tsc": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2",
    "arg-services": "^4",
    "immer": "^11",
    "parse5": "^8",
    "temporal-polyfill": "^0.3"
  },
  "devDependencies": {
    "@argdown/core": "^2",
    "graphology": "^0.26",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^5",
    "zod": "^4"
  },
  "peerDependencies": {
    "@argdown/core": "^2",
    "graphology": "^0.26"
  },
  "peerDependenciesMeta": {
    "@argdown/core": {
      "optional": true
    },
    "graphology": {
      "optional": true
    }
  }
}
