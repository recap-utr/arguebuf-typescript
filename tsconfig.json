{
  "include": ["src", "tests", "vitest.config.ts"],
  "compilerOptions": {
    "target": "ES2025",
    "module": "NodeNext",
    "paths": { "#/*": ["./src/*"] },
    "lib": ["ES2025", "DOM"],
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
